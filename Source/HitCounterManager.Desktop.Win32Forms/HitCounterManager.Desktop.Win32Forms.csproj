  <PropertyGroup>
    <!-- Consumed by pipeline START -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Consumed by pipeline END -->

    <OutputType>WinExe</OutputType>
    <PackageId>$(Product).Desktop.Win32Forms</PackageId>
    <!-- https://docs.microsoft.com/en-us/dotnet/core/rid-catalog -->
    <RuntimeIdentifiers>win</RuntimeIdentifiers>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization><!--BinaryFormatter support for ASC (see https://aka.ms/binaryformatter)-->
    <ApplicationIcon>../$(Product)/Resources/FireIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../$(Product)/$(Product).PCL.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.14" /><!--BinaryFormatter support for ASC (see https://aka.ms/binaryformatter)-->
  </ItemGroup>
</Project>
